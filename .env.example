# Copy this file to ".env" (same folder) and fill in the real values.
# ".env" is ignored by git on purpose: never commit it and never paste its values into chat.
# The real values are the ones set in Vercel → Settings → Environment Variables and in Supabase.

# Database (Supabase). Use the pooled connection (port 6543) here and the direct one below.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER-HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT-HOST:5432/postgres"

# Sign-in. Any long random string; locally it can differ from the one on Vercel.
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# File uploads on the Leads page (Supabase Storage). Optional: without them the form says
# "File storage is not configured" and only attaching files is unavailable.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key-from-supabase-project-settings-api"

# Optional
# CRM_TIMEZONE="Asia/Kolkata"
# LEAD_ATTACHMENTS_BUCKET="lead-attachments"

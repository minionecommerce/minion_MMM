# Copy to .env.local and fill in. Never commit real values.

# --- Database (Supabase) ---------------------------------------------------
# LOCAL DEVELOPMENT: use the session-mode pooler (port 5432) for BOTH urls.
# A long-lived local `next dev` process gains nothing from pgbouncer, and this
# avoids the slow first connection some networks see on the port 6543 pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# VERCEL (Production AND Preview) must NOT copy the two lines above.
# Serverless functions open many short-lived connections, so DATABASE_URL has to
# stay on the transaction pooler (6543) with a single connection per function,
# otherwise the pool runs out ("Timed out fetching a new connection"):
#   DATABASE_URL = postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = (the port 5432 url above; only used for migrations)

# --- Auth ---
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# --- File storage (lead attachments) ---
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
